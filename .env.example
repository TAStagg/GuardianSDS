# --- DATABASE SETTINGS ---
# Each user will provide their own PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/guardiansds"

# --- AI & EXTRACTION ---
# Users must sign up for their own OpenAI/Anthropic accounts
OPENAI_API_KEY=your_api_key_here

# --- SDS DATA PROVIDERS ---
# If they choose to use a professional database like CloudSDS
SDS_MANAGER_API_KEY=your_api_key_here
CLOUD_SDS_CLIENT_ID=your_id_here

# --- APP SETTINGS ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
